# ============================================================
# SlideHub — Variáveis de ambiente do backend
# Copie para .env e ajuste os valores:  copy .env.example .env
# ============================================================

# Porta do servidor Express (a Hostinger injeta a PORT automaticamente)
PORT=3000

# Banco SQLite — caminho do arquivo (em produção use um local persistente,
# ex.: file:/home/usuario/slidehub/db/slidehub.db)
DATABASE_URL="file:./dev.db"

# Segredo do JWT — troque por uma string longa e aleatória!
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio

# Usuário administrador criado pelo seed
ADMIN_EMAIL=admin@slidehub.com
ADMIN_PASSWORD=Admin@1234

# ------------------------------------------------------------
# Pagamento Pix
# PAYMENT_MODE: "mock" (simulação, para desenvolver/testar sem
# credenciais) ou "mp" (Mercado Pago real)
# ------------------------------------------------------------
PAYMENT_MODE=mock

# Credenciais Mercado Pago (obrigatórias apenas com PAYMENT_MODE=mp)
# 1. Acesse https://www.mercadopago.com.br/developers
# 2. "Suas integrações" -> crie uma aplicação
# 3. Copie o "Access Token" de produção (APP_USR-...)
# 4. Em "Webhooks" crie o webhook apontando para
#    https://SEU-DOMINIO/api/pagamentos/webhooks/pix e copie o segredo
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ------------------------------------------------------------
# URLs
# PUBLIC_URL: URL pública do site (usada no webhook e CORS)
# FRONTEND_URL: apenas para desenvolvimento (Vite em :5173)
# ------------------------------------------------------------
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------
# Uploads
# UPLOAD_DIR: pasta que guarda os arquivos (em produção use um
# local persistente fora do diretório do app, se disponível)
# UPLOAD_MAX_SIZE_MB: tamanho máximo de CADA arquivo (MB)
# ------------------------------------------------------------
UPLOAD_DIR=
UPLOAD_MAX_SIZE_MB=25

# true quando o site roda atrás de HTTPS (Hostinger: true)
COOKIE_SECURE=false
